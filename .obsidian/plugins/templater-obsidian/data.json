{
  "command_timeout": 5,
  "templates_folder": "_meta/templates",
  "templates_pairs": [
    [
      "",
      ""
    ]
  ],
  "trigger_on_file_creation": true,
  "auto_jump_to_cursor": false,
  "enable_system_commands": false,
  "shell_path": "",
  "user_scripts_folder": "-/templater/scripts",
  "enable_folder_templates": true,
  "folder_templates": [
    {
      "folder": "journal/2026",
      "template": "_meta/templates/daily.md"
    },
    {
      "folder": "10-projects",
      "template": "_meta/templates/project.md"
    },
    {
      "folder": "00-inbox",
      "template": "_meta/templates/capture.md"
    }
  ],
  "enable_file_templates": false,
  "file_templates": [
    {
      "regex": ".*",
      "template": ""
    }
  ],
  "syntax_highlighting": true,
  "syntax_highlighting_mobile": false,
  "enabled_templates_hotkeys": [],
  "startup_templates": [],
  "intellisense_render": 1,
  "enable_ribbon_icon": false
}
